# ---------------------------------------------------------------------------
# Cottage App — environment. Copy to .env.local for development.
# Never commit real credentials.
# ---------------------------------------------------------------------------

# Neon Postgres. Use the *development* branch locally, production on Railway.
DATABASE_URL="postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Neon Auth (magic link). Neon Auth is powered by Better Auth; `baseUrl` comes
# from `neon neon-auth status --project-id <id> --branch <branch>`.
NEON_AUTH_BASE_URL="https://ep-xxx.neonauth.c-10.us-east-1.aws.neon.tech/neondb/auth"
# 32+ characters. Generate once, then keep it stable — changing it signs
# everyone out. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
NEON_AUTH_COOKIE_SECRET=""

# Deployed public URL (the domain the app is actually served from in
# production, http://localhost:3000 locally). Read by scripts/bucket-cors.ts,
# which turns it into a bucket CORS origin — a wrong value there costs uploads.
APP_URL="http://localhost:3000"

# Cottage timezone — all human-facing times render in this zone.
APP_TIMEZONE="America/Toronto"

# Feature flags. Must default to false; parse only explicit truthy values.
FEATURE_JUNO_ENABLED="false"

# Ollama Cloud (runtime AI meal descriptions, spec §9.4). Leave OLLAMA_API_KEY
# blank to disable — renaming a meal then just clears the description, same
# as before this existed. Get a key at ollama.com/settings/keys.
OLLAMA_API_KEY=""
OLLAMA_MODEL="glm-5.3-flash:cloud"

# Railway Bucket (S3-compatible, private). Railway injects these when the
# bucket is linked to the service; keep Railway's own variable names.
AWS_ENDPOINT_URL_S3=""
AWS_REGION="us-east-1"
BUCKET_NAME=""

# Any *additional* domain that serves the app, comma-separated. Railway's own
# variables only ever name the canonical domain, so a generated
# *.up.railway.app domain that is still live has to be listed here to keep
# uploading. See "Bucket CORS" in the README.
BUCKET_CORS_EXTRA_ORIGINS=""

AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
